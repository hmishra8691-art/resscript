{
  "name": "resscript",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:graph": "depcruise --config .dependency-cruiser.cjs packages apps",
    "lint:migrations": "node tools/ci/lint-migrations.mjs",
    "verify": "pnpm lint:graph && pnpm lint:graph:test && pnpm lint:migrations && pnpm typecheck && pnpm build && pnpm lint:packaging && pnpm test",
    "db:up": "node tools/migrate/cli.mjs up",
    "db:reset": "node tools/migrate/cli.mjs reset",
    "db:test": "node tools/migrate/cli.mjs test",
    "lint:graph:test": "node tools/ci/test-graph-rules.mjs",
    "lint:packaging": "node tools/ci/lint-packaging.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "dependency-cruiser": "^16.4.2",
    "pg": "^8.13.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
