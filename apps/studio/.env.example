# Studio environment. Committed placeholders exist so `pnpm build` and `pnpm test` succeed
# without a live Supabase: every client construction in src/server/* is lazy and throws only
# when a request actually needs the network (see src/server/env.ts).
#
# The URL/anon key pair is the browser-safe credential. It is safe to expose because every
# table in `app` has RLS ENABLED + FORCED (db/migrations/0004_tenancy) and the anon key
# carries no claims: without a JWT, `app.current_org()` is NULL and every policy denies.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# Service-role key. Used for exactly ONE thing: re-minting a user's access token with a new
# `app_metadata.active_org_id` on org switch (POST /api/v1/orgs/:id/switch). It bypasses RLS,
# so it is never used for reads and never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Optional: log level for @resscript/observability's structured logger.
LOG_LEVEL=info
