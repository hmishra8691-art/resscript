{
  "name": "@resscript/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --passWithNoTests",
    "dev": "node --watch dist/server.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@resscript/compiler": "workspace:*",
    "@resscript/observability": "workspace:*",
    "@resscript/schema": "workspace:*",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
