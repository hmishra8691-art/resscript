-- Deliverable D §6.3, "Statement forms, illustrated", as close to verbatim as the fixture
-- registry allows. Two substitutions, both because a ref has to resolve for the resolver to
-- have anything to check:
--   * §6.3's MASK/PIPE target Q6, which is a numeric question in this fixture (D §9.2 needs
--     `Q6 > 10`), so the masked question here is Q10 — which shares Q5's option list, which is
--     the point of the example.
--   * The QUOTA block is in quota-deferred.rsl, because it is P2-06.

-- Question with all the option programmability from schema §5.1
QUESTION Q5
  TYPE MULTI
  LABEL "Which of these fruits have you bought in the last month?"
  REQUIRED
  OPTIONS
    1 "Apple"
    2 "Banana"
    3 "Cherry" VISIBLE IF S1 = 1
    4 "Durian" ENABLED IF AGE >= 18
    97 "Other" SPECIFY TEXT
    99 "None of these" EXCLUSIVE ANCHOR LAST
  VALIDATE
    SELECT AT LEAST 1
    SELECT AT MOST 3 MESSAGE "err.max_three"
  RANDOMIZE OPTIONS KEEP OPTION 97, 99 LAST GROUP fruit_list
END

-- Option-level surgery, straight from the brief's example set
HIDE Q3 OPTION 4
HIDE Q3 OPTION WHERE item.meta.discontinued = TRUE
DISABLE Q7 ROW 2, 5

-- Randomization, including the anchored form and the shared-group form
RANDOMIZE Q9 OPTIONS KEEP OPTION 1 FIRST
RANDOMIZE Q10 OPTIONS GROUP fruit_list        -- same order as Q5, per schema §12 group_ref
RANDOMIZE BLOCK MAIN SUBSET 2 EVENLY          -- counter-based, not PRNG (ADR-006 / schema §6)

-- Masking and piping
MASK Q10 OPTIONS TO SELECTED IN Q5 WHEN EMPTY SKIP
PIPE Q10 FROM Q5 AS LIST

-- Rules, including nesting and multi-effect
IF S1 = 1 AND (Q5 ANY OF [1, 3] OR COUNT(Q5) >= 3) AND NOT (AGE < 18)
  THEN SHOW Q12 AND SET PRIORITY_SEGMENT = "high"
  ELSE HIDE Q12

IF NOT ANSWERED(Q5) AND SHOWN(Q5) THEN FLAG incomplete_q5

TERMINATE AS SCREENOUT IF S1 = 2 OR AGE < 18
