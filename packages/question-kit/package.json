{
  "name": "@resscript/question-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "node": "./dist/react.js",
      "default": "./src/react.ts"
    },
    "./testkit": {
      "types": "./src/testkit/index.ts",
      "node": "./dist/testkit/index.js",
      "default": "./src/testkit/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@resscript/schema": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fast-check": "^3.23.2",
    "jsdom": "^25.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
